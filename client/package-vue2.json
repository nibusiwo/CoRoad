    "@dcloudio/uni-cli-shared": "^2.5.15",
    "@dcloudio/uni-h5": "^2.5.15",
    "@dcloudio/uni-helper-json": "^1.0.13",
    "@dcloudio/uni-mp-weixin": "^2.5.15",
    "@dcloudio/uni-quickapp-webview": "^2.5.15",
    "@dcloudio/vue-cli-plugin-hbuilder-plus": "latest",
    "@dcloudio/vue-cli-plugin-uni": "^2.5.15",
    "@dcloudio/vue-cli-plugin-uni-optimize": "^2.5.15",
